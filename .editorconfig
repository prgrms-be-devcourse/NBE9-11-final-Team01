# 위치: 프로젝트 루트 `.editorconfig` (snaptix/.editorconfig)
# ktlint(gradle 플러그인)는 이 파일을 자동으로 읽는다.
# detekt MaxLineLength(120)와 기준을 맞춰 ktlintFormat ↔ detekt 충돌을 제거한다.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
# 함수 식 본문이 max_line_length를 넘으면 다음 줄로 래핑 (한 줄로 다시 합치지 않음)
ktlint_function_signature_body_expression_wrapping = default
