# =============================================================================
# loadtest/seed/.env.example
#
# 복사 후 .env 로 사용하세요:
#   cp loadtest/seed/.env.example loadtest/seed/.env
#
# .env는 .gitignore에 추가하세요. (.env.example 만 커밋)
# =============================================================================

# ── 서버 ─────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8080

# ── 어드민 계정 (LoadTestDataInitializer 가 앱 기동 시 자동 생성) ─────────────
ADMIN_EMAIL=admin@snaptix.kr
ADMIN_PASSWORD=Admin1234!

# ── 테스트 유저 (LoadTestDataInitializer 가 앱 기동 시 자동 생성) ─────────────
USER_COUNT=200
USER_EMAIL_PREFIX=load-user
USER_EMAIL_DOMAIN=test.com
USER_PASSWORD=Test1234!

# ── 이벤트 설정 ───────────────────────────────────────────────────────────────
TOTAL_CAPACITY=100

# ── Docker 컨테이너명 (loadtest 전용 — docker-compose.loadtest.yml 기준) ──────
REDIS_CONTAINER=snaptix-redis-loadtest

# ── 아래 값은 seed.sh 실행 후 자동으로 채워집니다 ─────────────────────────────
# EVENT_ID=
# ZONE_ID=
# REDIS_STOCK_KEY=
